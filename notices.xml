<?xml version="1.0" encoding="UTF-8"?>
<!--
  Innioasis Updater CE Notice Feed Markup Specification
  Hosted at: https://innioasis.app/notice.xml (and https://innioasis.app/notices.xml)

  Displays on-screen hint toast announcements to users of the app and website.

  Fields:
  - id: required, unique string identifier for the notice.
  - persistent: boolean ("true" | "false", default: "false").
      * "false" (or omitted): Non-persistent notice. When dismissed by the user,
        it is permanently dismissed and will not return on the next app run.
      * "true": Persistent notice. It will return on every app launch, even if
        dismissed during a prior run.
      * CACHE INVALIDATION: If the remote notice.xml contents change from the
        locally cached file on the user's computer, the new file is automatically
        loaded and the updated notice is shown, even if previously dismissed.
  - severity: "info" | "warning" | "critical" (default: "info").
  - type: optional "player_update" | "app_update" for release category filtering.
  - from: optional ISO date YYYY-MM-DD (or timestamp). Shown on or after this date.
  - until: optional ISO date YYYY-MM-DD. Shown on or before this date.
  - models: optional comma-separated list of target models (e.g. "Y1,Y2"). Omit for all models.
  - platform: optional comma-separated list of target platforms ("windows,mac,linux"). Omit for all.

  Child elements:
  - <title>: required, headline of the notice.
  - <content>: required, short banner description/body text (also supports <body>).
  - <full_content>: optional, extended description shown in the Notices dialog and web page.
  - <url>: optional URL opened when the user clicks the See More / action button in Updater CE.
  - <link>: optional URL alias for backwards compatibility with earlier Updater CE builds.
-->
<notices updated="2026-11-02">

  <notice id="2026-10-31-firmware-advisory" persistent="false" severity="info" from="2026-10-31" until="2026-12-31" models="Y1">
    <title>Bricking issue fixed for Rockbox-Y1.</title>
    <content>Rockbox-Y1 0.5 is now compatible with Y1s sold after April 2026.</content>
    <full_content>Innioasis Y1 players shipped after April 2026 (Type B hardware with pre-installed software 3.0.7 or newer) are now supported by Rockbox-Y1 0.5 and newer builds in Updater CE. Updater CE automatically filters incompatible older packages to protect Type B hardware.</full_content>
    <url>https://innioasis.app/rockbox-y1-software.html</url>
    <link>https://innioasis.app/rockbox-y1-software.html</link>
  </notice>

  <notice id="2026-10-25-firmware-advisory" persistent="false" severity="info" from="2026-10-25" until="2026-12-31">
    <title>About Notices in Updater CE</title>
    <content>You'll get important alerts about device safety issues reported by the community here, such as when devices are being bricked by certain firmware.</content>
    <full_content>The Notices feed delivers community-verified hardware advisories, firmware compatibility warnings for Type A and Type B players, and new software announcements across Updater CE, Firmware Archive, and Themes Gallery.</full_content>
    <url>https://innioasis.app/notices.html</url>
    <link>https://innioasis.app/notices.html</link>
  </notice>

</notices>
